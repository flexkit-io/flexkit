{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/styles.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": "fk"
  },
  "aliases": {
    "components": "src/ui",
    "ui": "src/ui/primitives",
    "utils": "src/ui/lib/utils",
    "lib": "src/ui/lib",
    "hooks": "src/ui/hooks"
  },
  "registries": {
    "@ai-elements": "https://elements.ai-sdk.dev/api/registry/{name}.json"
  }
}
