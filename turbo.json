{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "15",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "FLEXKIT_DOMAIN"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DEBUG"
      ]
    },
    "start": {},
    "clean": {
      "cache": false
    },
    "ui:add": {
      "cache": false
    }
  }
}
